[Unit]
Description=pfSense Route List Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=routeportal
Group=routeportal
EnvironmentFile=/etc/route-portal.env
ExecStart=/usr/bin/python3 /opt/route-portal/app.py
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/route-portal

[Install]
WantedBy=multi-user.target
